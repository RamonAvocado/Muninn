# Optional fallback; each project can set its own token in Project settings
GITHUB_TOKEN=paste-token-here
# Encrypts per-project GitHub tokens in the DB. Generate with: openssl rand -base64 32
# Changing or losing it means re-entering every project token.
TOKEN_SECRET=paste-secret-here

# Sign-in (@mimird/auth). Required in production; dev falls back to an insecure secret.
# Use 32+ chars, different from every other app's: openssl rand -base64 32
SESSION_SECRET=paste-secret-here
APP_URL=http://localhost:3002
# Optional Google/GitHub login
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
